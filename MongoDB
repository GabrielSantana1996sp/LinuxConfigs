###3 Instalar Mongot

```
bash
cd ~/Downloads
tar -xvf mongot_community_0.65.1_linux_x86_64.tgz
sudo cp -r mongot-community-0.65.1-linux-x86_64 /usr/local/mongot-community
sudo ln -s /usr/local/mongot-community/mongot /usr/local/bin/mongot
---
### Criar diretório de dados do mongot:
---
```
bash
sudo mkdir -p /var/lib/mongot
sudo chown $(whoami):$(whoami) /var/lib/mongot
Executar com config:

```
bash
mongot --config /usr/local/mongot-community/config.default.yml
4 Instalar Java para Mongot

```
bash
sudo apt update
sudo apt install -y openjdk-21-jdk
sudo update-alternatives --config java
Wrapper sugerido /usr/local/bin/mongot:

```
bash
#!/usr/bin/env bash
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ $OSTYPE == "darwin"* ]]; then
  export JAVA_HOME="${DIR}/bin/jdk/Contents/Home"
else
  export JAVA_HOME="/usr"
fi

run_mongot() {
  exec "${JAVA_HOME}/bin/java" \
    -XX:+ExitOnOutOfMemoryError \
    -Djava.security.egd=file:/dev/urandom \
    --add-modules=jdk.incubator.vector \
    --enable-preview \
    --enable-native-access=ALL-UNNAMED \
    ${JVM_FLAGS} \
    -cp "/usr/local/mongot-community/lib/*:/usr/local/mongot-community/bin/mongot_community_deploy.jar" \
    com.xgen.mongot.community.MongotCommunity \
    "${PASS_THROUGH_ARGS[@]:-}"
}

run_mongot "$@"
Tornar executável:

```
bash
sudo chmod +x /usr/local/bin/mongot
Configurações essenciais
Exemplo de mongod.conf
yaml
storage:
  dbPath: /var/lib/mongodb

systemLog:
  destination: file
  logAppend: true
  path: /var/log/mongodb/mongod.log

net:
  port: 27017
  bindIp: 127.0.0.1

processManagement:
  timeZoneInfo: /usr/share/zoneinfo

security:
  authorization: enabled
  keyFile: /etc/mongodb/mongo-keyfile

replication:
  replSetName: rs0

search:
  enabled: true
  path: /usr/local/mongot-community/mongot
Gerar keyFile para autenticação interna

```
bash
sudo mkdir -p /etc/mongodb
sudo sh -c "openssl rand -base64 756 > /etc/mongodb/mongo-keyfile"
sudo chmod 400 /etc/mongodb/mongo-keyfile
sudo chown mongodb:mongodb /etc/mongodb/mongo-keyfile
Segredos do Mongot

```
bash
sudo mkdir -p /etc/mongot/secrets
echo "senhaSeguraAqui" | sudo tee /etc/mongot/secrets/passwordFile > /dev/null
sudo chmod 600 /etc/mongot/secrets/passwordFile
sudo chown $(whoami):$(whoami) /etc/mongot/secrets/passwordFile
