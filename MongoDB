#MongoDB Community Server Download


cd ~/Downloads
tar -xvf mongot_community_0.65.1_linux_x86_64.tgz
cd mongot-community-0.65.1-linux-x86_64
cd ~/Downloads/mongot-community
ls
sudo cp -r ~/Downloads/mongot-community /usr/local/
sudo ln -s /usr/local/mongot-community/mongot /usr/local/bin/mongot

nano ~/.local/share/applications/mongodb-compass.desktop

[Desktop Entry]
Name=MongoDB Compass
Comment=GUI for MongoDB
Exec=mongodb-compass
Icon=mongodb-compass
Terminal=false
