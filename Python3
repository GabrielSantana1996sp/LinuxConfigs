#Entrair arquivo
cd ~/Downloads
tar -xf Python-3.14.5.tar.xz
cd Python-3.14.5

#Compilação e instalação
./configure --enable-optimizations
make -j$(nproc)
sudo make altinstall

#trocar como padrão
sudo update-alternatives --install /usr/bin/python3 python3 /usr/local/bin/python3.14 2
sudo update-alternatives --config python3

#Testar o pip junto com o novo Python
python3 -m pip --version

#Criar um ambiente virtual para instalar pacotes sem risco de conflito:
python3 -m venv ~/venvs/projeto1
source ~/venvs/projeto1/bin/activate
Instalar pacotes essenciais como setuptools, wheel e virtualenv para deixar o ambiente pronto.

